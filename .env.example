# Google OAuth
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxxx

# Gmail refresh token (get this once via OAuth consent flow)
GMAIL_REFRESH_TOKEN=1//0g-xxxxxxxxxxxxxxxxxxxxxx

# Telegram
TELEGRAM_BOT_TOKEN=7891234567:AAF-xxxxxxxxxxxxxxxxxxx
TELEGRAM_CHAT_ID=123456789

# Database (Neon / Vercel Postgres / Supabase — any Postgres URL works)
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# Vercel Blob (auto-injected by Vercel when you enable Blob storage)
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxxxxxx

# Admin emails (comma-separated)
ADMIN_EMAILS=admin@shop.com,admin@gmail.com
